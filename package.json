{
  "name": "handybandi-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build && node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "deploy:prepare": "pnpm db:migrate && pnpm db:seed && pnpm admin:bootstrap",
    "check": "tsc --noEmit",
    "lint": "tsc --noEmit && pnpm format:check",
    "admin:bootstrap": "tsx --env-file-if-exists=.env scripts/bootstrap-owner.ts",
    "test": "tsx --test tests/domain.test.ts",
    "test:browser": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:local": "node --env-file-if-exists=.env scripts/local-db.mjs",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "admin:create": "tsx --env-file-if-exists=.env scripts/create-admin.ts",
    "worker": "tsx --env-file-if-exists=.env scripts/worker.ts",
    "test:db": "tsx --env-file-if-exists=.env --test tests/integration.test.ts",
    "setup:local": "node scripts/setup-local.mjs",
    "staff:access": "tsx --env-file-if-exists=.env scripts/staff-access.ts",
    "worker:loop": "tsx --env-file-if-exists=.env scripts/worker-loop.ts",
    "format": "prettier --write src tests scripts prisma/seed.ts *.ts *.mjs *.json README.md docs/*.md",
    "format:check": "prettier --check src tests scripts prisma/seed.ts *.ts *.mjs *.json README.md docs/*.md"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@prisma/client": "6.19.3",
    "better-auth": "1.7.10",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "18.4.0-beta.17",
    "prettier": "^3.9.10",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "type": "module"
}
